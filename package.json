{
  "name": "pi-no-redundant-cd",
  "version": "0.1.1",
  "description": "Pi extension: stop coding agents prefixing bash calls with `cd <the directory they are already in> &&`. Blocks the first one with a reason, strips the rest.",
  "type": "module",
  "license": "MIT",
  "author": "Jorge Walendowsky Filho",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "coding-agent",
    "tokens"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jwalendowsky/pi-no-redundant-cd.git"
  },
  "homepage": "https://github.com/jwalendowsky/pi-no-redundant-cd#readme",
  "bugs": "https://github.com/jwalendowsky/pi-no-redundant-cd/issues",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "extensions/index.ts",
    "extensions/rule.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "scripts/estimate-savings.mjs"
  ],
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "scripts": {
    "test": "node --test extensions/*.test.ts scripts/*.test.mjs",
    "estimate": "node scripts/estimate-savings.mjs"
  },
  "engines": {
    "node": ">=22.18"
  }
}
